# Cookie values from a logged-in gemini.google.com session.
# Get them from your browser devtools: Application/Storage -> Cookies ->
# https://gemini.google.com -> copy __Secure-1PSID and __Secure-1PSIDTS.
SECURE_1PSID=
SECURE_1PSIDTS=

PORT=8787
LOG_LEVEL=INFO
# Optional, only if Gemini Web must be reached through a proxy.
# HTTPS_PROXY=
